{
	"name": "easynpm",
	"version": "2.0.0",
	"private": true,
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10",
		"@sveltejs/adapter-auto": "^8",
		"@sveltejs/kit": "^3",
		"@sveltejs/vite-plugin-svelte": "^7",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4",
		"eslint": "^10",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-svelte": "^3.9.0",
		"flowbite-svelte-icons": "^3",
		"globals": "^17",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^4",
		"svelte": "^5",
		"svelte-check": "^4.7.7",
		"svelte-eslint-parser": "^1.1.2",
		"tailwindcss": "^4",
		"tslib": "^2.8.1",
		"typescript": "^6",
		"typescript-eslint": "^8.26.1",
		"vite": "^8"
	},
	"type": "module",
	"dependencies": {
		"@floating-ui/dom": "^1.7.6",
		"date-fns": "^4",
		"flowbite": "^4",
		"flowbite-svelte": "^1",
		"svelte-markdown": "^0.4",
		"tailwind-merge": "^3"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
